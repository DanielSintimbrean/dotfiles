{
  "git_panel": {
    "tree_view": true
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "unified",
  "icon_theme": "Catppuccin Mocha",
  "theme": "Catppuccin Macchiato - No Italics",
  "redact_private_values": false,
  "vim_mode": true,
  "vim": {},
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "horizontal_scroll_margin": 8,
  "tab_bar": {
    "show": true
  },
  "scrollbar": {
    "show": "never"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager"
  },
  "project_panel": {
    "hide_root": true,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "show_diagnostics": "errors",
    "auto_fold_dirs": false,
    "button": true,
    "dock": "right",
    "git_status": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "auto_install_extensions": {
    "astro": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "lua": true,
    "qml": true,
    "toml": true
  },
  "file_types": {
    "HTML": [
      "svg"
    ]
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server"
      ]
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server"
      ]
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server"
      ]
    }
  },
  "buffer_font_family": "JetBrainsMono Nerd Font"
}
