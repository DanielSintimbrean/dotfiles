#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
backup_root=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-backups/$(date +%Y%m%d-%H%M%S)
dry_run=false

usage() {
  cat <<'USAGE'
Usage: ./install [options]

Options:
  --dry-run          Print changes without applying them
  -h, --help         Show this help
USAGE
}

while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run) dry_run=true ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

print_command() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
}

run() {
  print_command "$@"
  if ! $dry_run; then
    "$@"
  fi
}

configure_git_hooks() {
  local current_hooks_path

  current_hooks_path=$(git -C "$repo_root" config --local --get core.hooksPath || true)
  if [[ $current_hooks_path != .githooks ]]; then
    run git -C "$repo_root" config --local core.hooksPath .githooks
  fi
}

configure_caps2esc() {
  local target=/etc/interception/udevmon.yaml
  local source_config="$repo_root/setup/caps2esc/udevmon.yaml"

  if [[ ! -f $source_config ]]; then
    echo "Missing caps2esc configuration: $source_config" >&2
    exit 1
  fi

  run omarchy pkg add interception-tools interception-caps2esc

  if $dry_run; then
    echo "Would install the caps2esc udevmon job at $target"
    print_command sudo systemctl enable --now udevmon
    return
  fi

  run sudo install -Dm0644 "$source_config" "$target"
  run sudo systemctl enable --now udevmon
}

if ! command -v omarchy >/dev/null 2>&1; then
  echo "This installer requires Omarchy Quattro." >&2
  exit 1
fi

configure_git_hooks
run omarchy pkg add stow fish diff-so-fancy rsync
run omarchy install terminal ghostty

export DOTFILES_BACKUP_DIR=$backup_root
if $dry_run; then
  "$repo_root/stow-all" --dry-run
else
  "$repo_root/stow-all"
fi

if $dry_run; then
  "$repo_root/bin/dot-local/bin/dotfiles-configure-ghostty" --dry-run
else
  "$repo_root/bin/dot-local/bin/dotfiles-configure-ghostty"
fi

run mise install --yes

if ! $dry_run && [[ ! -x /usr/bin/fish ]]; then
  echo "Fish was not installed at /usr/bin/fish." >&2
  exit 1
fi

current_shell=$(getent passwd "$USER" | cut -d: -f7)
if [[ $current_shell != /usr/bin/fish ]]; then
  run chsh -s /usr/bin/fish
fi

configure_caps2esc

hyprland_instances=""
if command -v hyprctl >/dev/null 2>&1; then
  hyprland_instances=$(hyprctl instances -j 2>/dev/null || true)
fi

if [[ -n $hyprland_instances && $hyprland_instances != "[]" ]]; then
  if $dry_run; then
    print_command hyprctl reload
    print_command hyprctl configerrors
    print_command omarchy restart hyprsunset
  else
    hyprctl reload
    hyprland_errors=$(hyprctl configerrors)
    if [[ -n $hyprland_errors ]]; then
      echo "$hyprland_errors" >&2
      exit 1
    fi
    omarchy restart hyprsunset
  fi
fi

echo
if $dry_run; then
  echo "Dry run complete. No changes were applied."
else
  echo "Omarchy Quattro dotfiles are installed."
fi
echo "Fish is the login shell. Log out and back in if it changed during this run."
echo "Backups, when needed: $backup_root"
