#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source_root="$repo_root/skills"
dry_run=false

usage() {
  echo "Usage: ./sync-agent-skills [--dry-run]"
}

case ${1:-} in
  "") ;;
  --dry-run) dry_run=true ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [[ ! -d $source_root ]]; then
  echo "Missing agent skill source: $source_root" >&2
  exit 1
fi

if ! $dry_run && ! command -v rsync >/dev/null 2>&1; then
  echo "rsync is required. On Omarchy, run: omarchy pkg add rsync" >&2
  exit 1
fi

sync_to() {
  local destination=$1
  local source
  local skill
  local target
  local found=false

  if [[ -L $destination ]]; then
    echo "Expected a real skill directory, found a symlink: $destination" >&2
    return 1
  fi

  if $dry_run; then
    [[ -d $destination ]] || echo "Would create directory: $destination"
  else
    mkdir -p -- "$destination"
  fi

  while IFS= read -r -d '' source; do
    found=true
    skill=${source##*/}
    target="$destination/$skill"

    if [[ ! -f $source/SKILL.md ]]; then
      echo "Agent skill is missing SKILL.md: $source" >&2
      return 1
    fi
    if [[ -L $target ]]; then
      echo "Expected a copied skill, found a symlink: $target" >&2
      return 1
    fi

    if $dry_run; then
      echo "Would copy: $source -> $target"
    else
      rsync --archive --copy-links --delete -- "$source/" "$target/"
      if [[ -n $(find "$target" -type l -print -quit) ]]; then
        echo "Copied skill contains a symlink: $target" >&2
        return 1
      fi
      echo "Copied agent skill: $target"
    fi
  done < <(find "$source_root" -mindepth 1 -maxdepth 1 -type d -print0 | LC_ALL=C sort -z)

  if ! $found; then
    echo "No agent skills found under: $source_root" >&2
    return 1
  fi
}

sync_to "$HOME/.agents/skills"
sync_to "$HOME/.claude/skills"
