#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
managed_paths=(apps bin editor fish git hyprland startship system terminal tmux)

usage() {
  cat <<'USAGE'
Usage: ./check-sync [--managed-files | --worktree | --commit <ref>]

Without arguments, check the working tree and validate the Hyprland
configuration committed at HEAD.

Options:
  --managed-files   Reject untracked files inside managed Stow packages
  --worktree        Reject untracked repository files and staged changes
  --commit <ref>    Validate Hyprland from the committed snapshot at <ref>
  -h, --help        Show this help
USAGE
}

check_untracked_files() {
  local heading=$1
  shift
  local path
  local -a untracked=()

  while IFS= read -r -d '' path; do
    untracked+=("$path")
  done < <(
    git -C "$repo_root" ls-files --others --exclude-standard -z -- "$@"
  )

  if (( ${#untracked[@]} == 0 )); then
    return
  fi

  echo "$heading" >&2
  printf '  %s\n' "${untracked[@]}" >&2
  echo >&2
  echo "Add them to Git or move/remove them before applying or syncing." >&2
  return 1
}

check_no_staged_changes() {
  local path

  if git -C "$repo_root" diff --cached --quiet; then
    return
  fi

  echo "Staged changes have not been committed:" >&2
  while IFS= read -r -d '' path; do
    printf '  %s\n' "$path" >&2
  done < <(git -C "$repo_root" diff --cached --name-only -z)
  echo >&2
  echo "Commit or unstage them before syncing." >&2
  return 1
}

validate_committed_hyprland() (
  local requested_ref=$1
  local commit
  local snapshot_root
  local snapshot_repo
  local validation_home
  local config
  local validation_output

  if ! commit=$(git -C "$repo_root" rev-parse --verify "${requested_ref}^{commit}" 2>/dev/null); then
    echo "Not a commit: $requested_ref" >&2
    return 1
  fi

  snapshot_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sync.XXXXXX")
  snapshot_repo="$snapshot_root/repository"
  validation_home="$snapshot_root/home"
  mkdir -p "$snapshot_repo" "$validation_home/.config" "$validation_home/.local/state"

  trap 'rm -r -- "$snapshot_root"' EXIT

  git -C "$repo_root" archive --format=tar "$commit" | tar -xf - -C "$snapshot_repo"

  config="$snapshot_repo/hyprland/dot-config/hypr/hyprland.lua"
  if [[ ! -f $config ]]; then
    echo "Committed Hyprland entrypoint is missing at $requested_ref." >&2
    return 1
  fi

  ln -s "$snapshot_repo/hyprland/dot-config/hypr" "$validation_home/.config/hypr"

  if validation_output=$(
    HOME="$validation_home" \
      XDG_CONFIG_HOME="$validation_home/.config" \
      XDG_STATE_HOME="$validation_home/.local/state" \
      Hyprland --verify-config --config "$config" 2>&1
  ); then
    printf 'Committed Hyprland configuration is valid at %s.\n' "${commit:0:12}"
  else
    printf '%s\n' "$validation_output" >&2
    echo "Committed Hyprland configuration is invalid at ${commit:0:12}." >&2
    return 1
  fi
)

case ${1:-} in
  "")
    check_untracked_files "Untracked repository files must be added or ignored:"
    check_no_staged_changes
    validate_committed_hyprland HEAD
    ;;
  --managed-files)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    check_untracked_files "Untracked files exist inside managed Stow packages:" "${managed_paths[@]}"
    ;;
  --worktree)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    check_untracked_files "Untracked repository files must be added or ignored:"
    check_no_staged_changes
    ;;
  --commit)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    validate_committed_hyprland "$2"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
