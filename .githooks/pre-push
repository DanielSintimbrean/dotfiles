#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

"$repo_root/check-sync" --worktree

while read -r _local_ref local_oid _remote_ref _remote_oid; do
  if [[ $local_oid =~ ^0+$ ]]; then
    continue
  fi

  "$repo_root/check-sync" --commit "$local_oid"
done
